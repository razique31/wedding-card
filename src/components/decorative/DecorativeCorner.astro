---
interface Props {
  class?: string;
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
}

const { class: className = '', position = 'top-left' } = Astro.props;

const positionClasses = {
  'top-left': 'top-0 left-0',
  'top-right': 'top-0 right-0 rotate-90',
  'bottom-right': 'bottom-0 right-0 rotate-180',
  'bottom-left': 'bottom-0 left-0 -rotate-90',
};
---
<svg 
  class={`absolute w-8 h-8 pointer-events-none text-[#C9A96E] ${positionClasses[position]} ${className}`} 
  viewBox="0 0 40 40" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M 0 0 L 40 0" stroke="currentColor" stroke-width="1.5"/>
  <path d="M 0 0 L 0 40" stroke="currentColor" stroke-width="1.5"/>
  <path d="M 5 5 Q 20 5 20 20 Q 5 20 5 5 Z" stroke="currentColor" stroke-width="1" fill="none" />
  <circle cx="20" cy="20" r="1.5" fill="currentColor" />
  <circle cx="5" cy="5" r="1" fill="currentColor" />
</svg>
