---
interface Props {
  variant?: 'background' | 'accent';
  opacity?: number;
  class?: string;
}

const { 
  variant = 'background', 
  opacity = variant === 'background' ? 0.04 : 0.15, 
  class: className = '' 
} = Astro.props;
---
{variant === 'background' ? (
  <svg 
    class={`absolute inset-0 w-full h-full pointer-events-none ${className}`} 
    style={`opacity: ${opacity};`}
    aria-hidden="true" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="islamic-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
        <g stroke="#C9A96E" stroke-width="1.5" fill="none">
          <!-- Center star -->
          <rect x="35" y="35" width="30" height="30" />
          <rect x="35" y="35" width="30" height="30" transform="rotate(45 50 50)" />
          <!-- Connecting lines -->
          <path d="M 0 50 L 35 50 M 65 50 L 100 50 M 50 0 L 50 35 M 50 65 L 50 100" />
          <!-- Corner stars partial -->
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45 0 0)" />
          <rect x="85" y="-15" width="30" height="30" />
          <rect x="85" y="-15" width="30" height="30" transform="rotate(45 100 0)" />
          <rect x="-15" y="85" width="30" height="30" />
          <rect x="-15" y="85" width="30" height="30" transform="rotate(45 0 100)" />
          <rect x="85" y="85" width="30" height="30" />
          <rect x="85" y="85" width="30" height="30" transform="rotate(45 100 100)" />
        </g>
      </pattern>
    </defs>
    <rect x="0" y="0" width="100%" height="100%" fill="url(#islamic-pattern)" />
  </svg>
) : (
  <svg 
    class={`pointer-events-none ${className}`} 
    style={`opacity: ${opacity};`}
    aria-hidden="true"
    viewBox="0 0 100 100"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g stroke="#C9A96E" stroke-width="2" fill="none">
      <rect x="25" y="25" width="50" height="50" />
      <rect x="25" y="25" width="50" height="50" transform="rotate(45 50 50)" />
      <circle cx="50" cy="50" r="10" />
      <path d="M 50 5 L 50 25 M 50 75 L 50 95 M 5 50 L 25 50 M 75 50 L 95 50" />
    </g>
  </svg>
)}
