---
/**
 * Countdown.astro — Live countdown to 27 December 2026
 *
 * Art direction: lavender/ivory background, gold counter boxes with
 * arabesque SVG corner accents. Vanilla JS setInterval only — no GSAP.
 * Static fallback: noscript shows the date string.
 */
---

<section
  id="countdown"
  class="relative section-padding-sm text-center overflow-hidden"
  aria-label="Countdown to the wedding"
  style="background: linear-gradient(180deg, #EDE8F5 0%, #FAF7F0 100%);"
>

  <!-- Subtle jaali dot pattern background -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cd-dot-grid" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="12" cy="12" r="1" fill="#4A3060"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cd-dot-grid)"/>
    </svg>
  </div>

  <div class="relative z-10 w-full" data-parallax="0.04">

    <!-- Heading -->
    <div class="mb-3" data-reveal>
      <p class="text-[0.62rem] uppercase tracking-[0.4em] font-body font-medium" style="color: #9B87C0;">
        The Celebration Awaits
      </p>
      <h2 class="font-display text-charcoal mt-1" style="font-size: clamp(1.5rem, 5vw, 2.2rem);">
        Days Until the <em class="text-gold not-italic">Celebration</em>
      </h2>
    </div>

    <!-- Ornamental gold divider -->
    <div class="mb-10 flex items-center justify-center gap-3" aria-hidden="true" data-reveal>
      <span class="block h-px bg-gold/40" style="width: clamp(2rem, 8vw, 4rem);"></span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 0.5 L9.2 6.8 L15.5 8 L9.2 9.2 L8 15.5 L6.8 9.2 L0.5 8 L6.8 6.8 Z" fill="#C9A96E" opacity="0.8"/>
      </svg>
      <span class="block h-px bg-gold/40" style="width: clamp(2rem, 8vw, 4rem);"></span>
    </div>

    <!-- Countdown grid -->
    <div
      id="countdown-container"
      class="grid grid-cols-2 gap-4 max-w-xs mx-auto sm:grid-cols-4 sm:max-w-none"
      data-wedding-date="2026-12-27T00:00:00+05:30"
      aria-live="polite"
      aria-label="Countdown timer"
    >

      <!-- DAYS -->
      <div
        class="relative ornament-border bg-ivory/80 rounded-sm py-5 px-2"
        data-reveal
      >
        <!-- SVG arabesque corner accents -->
        <svg class="absolute top-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute top-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleX(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleY(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scale(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <span
          id="cd-days"
          class="countdown-digit block text-gold"
          style="font-size: clamp(2.2rem, 8vw, 3rem); line-height: 1;"
          aria-label="Days remaining"
        >--</span>
        <span class="block text-[0.58rem] uppercase tracking-[0.35em] text-charcoal-muted mt-2 font-body">Days</span>
      </div>

      <!-- HOURS -->
      <div
        class="relative ornament-border bg-ivory/80 rounded-sm py-5 px-2"
        data-reveal
      >
        <svg class="absolute top-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute top-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleX(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleY(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scale(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <span
          id="cd-hours"
          class="countdown-digit block text-gold"
          style="font-size: clamp(2.2rem, 8vw, 3rem); line-height: 1;"
          aria-label="Hours remaining"
        >--</span>
        <span class="block text-[0.58rem] uppercase tracking-[0.35em] text-charcoal-muted mt-2 font-body">Hours</span>
      </div>

      <!-- MINUTES -->
      <div
        class="relative ornament-border bg-ivory/80 rounded-sm py-5 px-2"
        data-reveal
      >
        <svg class="absolute top-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute top-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleX(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleY(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scale(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <span
          id="cd-mins"
          class="countdown-digit block text-gold"
          style="font-size: clamp(2.2rem, 8vw, 3rem); line-height: 1;"
          aria-label="Minutes remaining"
        >--</span>
        <span class="block text-[0.58rem] uppercase tracking-[0.35em] text-charcoal-muted mt-2 font-body">Minutes</span>
      </div>

      <!-- SECONDS -->
      <div
        class="relative ornament-border bg-ivory/80 rounded-sm py-5 px-2"
        data-reveal
      >
        <svg class="absolute top-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute top-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleX(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 left-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scaleY(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <svg class="absolute bottom-1 right-1 pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: scale(-1);">
          <path d="M1 15 L1 3 Q1 1 3 1 L15 1" stroke="#C9A96E" stroke-width="0.8" opacity="0.6"/>
          <circle cx="1" cy="1" r="1.5" fill="#C9A96E" opacity="0.5"/>
        </svg>
        <span
          id="cd-secs"
          class="countdown-digit block text-gold"
          style="font-size: clamp(2.2rem, 8vw, 3rem); line-height: 1;"
          aria-label="Seconds remaining"
        >--</span>
        <span class="block text-[0.58rem] uppercase tracking-[0.35em] text-charcoal-muted mt-2 font-body">Seconds</span>
      </div>
    </div>

    <!-- Celebration message (shown by JS when countdown ends) -->
    <p
      id="countdown-complete"
      class="font-display text-gold mt-8 hidden"
      style="font-size: clamp(1.1rem, 4vw, 1.5rem);"
    >
      The celebration has begun! ✦
    </p>

    <!-- noscript fallback -->
    <noscript>
      <p class="font-display text-charcoal mt-6" style="font-size: clamp(1rem, 4vw, 1.4rem);">
        27 December 2026
      </p>
    </noscript>

  </div>
</section>

<!-- Countdown script — vanilla JS, no GSAP, no TypeScript in template -->
<script>
  (function () {
    var WEDDING = new Date('2026-12-27T00:00:00+05:30').getTime();
    var dEl = document.getElementById('cd-days');
    var hEl = document.getElementById('cd-hours');
    var mEl = document.getElementById('cd-mins');
    var sEl = document.getElementById('cd-secs');
    var done = document.getElementById('countdown-complete');

    function pad(n: number) { return n < 10 ? '0' + n : String(n); }

    function update() {
      var diff = WEDDING - Date.now();
      if (diff <= 0) {
        if (dEl) dEl.textContent = '00';
        if (hEl) hEl.textContent = '00';
        if (mEl) mEl.textContent = '00';
        if (sEl) sEl.textContent = '00';
        if (done) done.classList.remove('hidden');
        clearInterval(timer);
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      if (dEl) dEl.textContent = String(d);
      if (hEl) hEl.textContent = pad(h);
      if (mEl) mEl.textContent = pad(m);
      if (sEl) sEl.textContent = pad(s);
    }

    update();
    var timer = setInterval(update, 1000);
  })();
</script>
