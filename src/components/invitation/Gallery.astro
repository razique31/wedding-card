---
/**
 * Gallery.astro — Editorial photo album composition
 *
 * Art direction: ivory/parchment background, 4 photos in layered/overlapping
 * editorial album composition with varying rotations, parchment borders,
 * SVG placeholders, rose petals, and lavender butterfly.
 */
---

<section
  id="gallery"
  class="relative section-padding overflow-hidden"
  aria-label="Our story photo gallery"
  style="background-color: #F5F0E8;"
>

  <!-- Lavender butterfly near top corner -->
  <div
    class="butterfly absolute pointer-events-none"
    aria-hidden="true"
    style="top: 5%; right: 6%; opacity: 0.5; animation-delay: 2s;"
  >
    <svg width="40" height="32" viewBox="0 0 36 28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M18 14 C18 14 6 2 2 6 C-2 10 8 18 18 14Z" fill="#9B87C0" opacity="0.7"/>
      <path d="M18 14 C18 14 30 2 34 6 C38 10 28 18 18 14Z" fill="#9B87C0" opacity="0.7"/>
      <path d="M18 14 C18 14 8 22 4 20 C0 18 10 12 18 14Z" fill="#C8B8E8" opacity="0.55"/>
      <path d="M18 14 C18 14 28 22 32 20 C36 18 26 12 18 14Z" fill="#C8B8E8" opacity="0.55"/>
      <line x1="18" y1="10" x2="18" y2="20" stroke="#4A3060" stroke-width="0.5" opacity="0.4"/>
    </svg>
  </div>

  <!-- Scattered rose petals -->
  <!-- Petal A -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="top: 12%; left: 3%; opacity: 0.5; animation-delay: 0.5s;">
    <svg width="18" height="24" viewBox="0 0 18 24" fill="none" style="transform: rotate(-28deg);">
      <path d="M9 1 C13 4 17 10 17 15 C17 20 13 23 9 23 C5 23 1 20 1 15 C1 10 5 4 9 1 Z" fill="#9B87C0" opacity="0.6"/>
    </svg>
  </div>
  <!-- Petal B -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="top: 30%; right: 4%; opacity: 0.4; animation-delay: 5s;">
    <svg width="15" height="20" viewBox="0 0 15 20" fill="none" style="transform: rotate(45deg);">
      <path d="M7.5 1 C11 4 14 9 14 13 C14 17 11 19 7.5 19 C4 19 1 17 1 13 C1 9 4 4 7.5 1 Z" fill="#C8B8E8" opacity="0.65"/>
    </svg>
  </div>
  <!-- Petal C -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="bottom: 25%; left: 6%; opacity: 0.45; animation-delay: 8s;">
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none" style="transform: rotate(-12deg);">
      <path d="M10 1 C15 1 19 5 19 7 C19 9 15 13 10 13 C5 13 1 9 1 7 C1 5 5 1 10 1 Z" fill="#9B87C0" opacity="0.55"/>
    </svg>
  </div>
  <!-- Petal D -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="bottom: 10%; right: 8%; opacity: 0.38; animation-delay: 3s;">
    <svg width="16" height="22" viewBox="0 0 16 22" fill="none" style="transform: rotate(70deg);">
      <path d="M8 1 C12 4 15 10 15 14 C15 18 12 21 8 21 C4 21 1 18 1 14 C1 10 4 4 8 1 Z" fill="#C8B8E8" opacity="0.6"/>
    </svg>
  </div>

  <!-- ── Section header ── -->
  <div class="text-center mb-12 relative z-10" data-reveal>
    <p class="text-[0.62rem] uppercase tracking-[0.4em] font-body font-medium mb-2" style="color: #9B87C0;">
      A Glimpse of Us
    </p>
    <h2
      class="font-display text-charcoal mb-3"
      style="font-size: clamp(1.6rem, 5vw, 2.4rem);"
    >
      Our Story
    </h2>
    <!-- Gold ornamental divider -->
    <div class="flex items-center justify-center gap-3" aria-hidden="true">
      <span class="block h-px bg-gold/40" style="width: clamp(2rem, 8vw, 4rem);"></span>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 1 L10.2 7.8 L17 9 L10.2 10.2 L9 17 L7.8 10.2 L1 9 L7.8 7.8 Z" fill="#C9A96E" opacity="0.75"/>
      </svg>
      <span class="block h-px bg-gold/40" style="width: clamp(2rem, 8vw, 4rem);"></span>
    </div>
  </div>

  <!-- ── Photo album composition ── -->
  <!-- 4 photos in editorial layered layout: 2 on first row slightly offset, 1 large centered, 1 offset bottom -->
  <div class="relative z-10 w-full">

    <!-- Row 1: Two photos, slightly staggered -->
    <div class="flex justify-center gap-4 mb-4" style="padding-inline: 0;">

      <!-- Photo 1 — left, rotated slightly left -->
      <div
        class="relative ornament-border bg-ivory p-2 rounded-sm"
        style="width: 45%; transform: rotate(-3deg); transform-origin: center bottom; animation-delay: 0.1s;"
        data-reveal
        data-parallax="0.07"
      >
        <div class="w-full aspect-[3/4] overflow-hidden bg-lavender/20">
          <!-- SVG placeholder: abstract plum/lavender shape -->
          <svg class="w-full h-full" viewBox="0 0 150 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="150" height="200" fill="#EDE8F5"/>
            <ellipse cx="75" cy="95" rx="45" ry="60" fill="#9B87C0" opacity="0.18"/>
            <ellipse cx="55" cy="80" rx="25" ry="35" fill="#4A3060" opacity="0.1"/>
            <circle cx="85" cy="110" r="20" fill="#C9A96E" opacity="0.08"/>
            <text x="75" y="165" text-anchor="middle" font-size="8" fill="#9B87C0" opacity="0.5" font-family="serif">PHOTO 1</text>
          </svg>
          <!--
            PLACEHOLDER: Replace with actual photo 1
            <img src="/images/gallery-1.webp" alt="Photo of couple" width="150" height="200"
                 class="w-full h-full object-cover" loading="lazy" decoding="async"/>
          -->
        </div>
        <!-- Parchment border inner shadow effect -->
        <div class="absolute inset-2 pointer-events-none border border-gold/15 rounded-sm" aria-hidden="true"></div>
      </div>

      <!-- Photo 2 — right, rotated slightly right, shifted down -->
      <div
        class="relative ornament-border bg-ivory p-2 rounded-sm self-end"
        style="width: 42%; transform: rotate(4deg); transform-origin: center bottom; animation-delay: 0.25s;"
        data-reveal
        data-parallax="0.05"
      >
        <div class="w-full aspect-[3/4] overflow-hidden bg-lavender/20">
          <svg class="w-full h-full" viewBox="0 0 140 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="140" height="190" fill="#F5F0E8"/>
            <ellipse cx="70" cy="90" rx="40" ry="55" fill="#C8B8E8" opacity="0.25"/>
            <ellipse cx="90" cy="70" rx="22" ry="30" fill="#4A3060" opacity="0.08"/>
            <circle cx="50" cy="110" r="18" fill="#C9A96E" opacity="0.1"/>
            <text x="70" y="158" text-anchor="middle" font-size="8" fill="#9B87C0" opacity="0.5" font-family="serif">PHOTO 2</text>
          </svg>
          <!--
            PLACEHOLDER: Replace with actual photo 2
            <img src="/images/gallery-2.webp" alt="Photo of couple" width="140" height="190"
                 class="w-full h-full object-cover" loading="lazy" decoding="async"/>
          -->
        </div>
        <div class="absolute inset-2 pointer-events-none border border-gold/15 rounded-sm" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Row 2: One large photo, centered -->
    <div class="flex justify-center mb-4">
      <div
        class="relative ornament-border bg-ivory p-3 rounded-sm"
        style="width: 72%; transform: rotate(-1.5deg); animation-delay: 0.4s;"
        data-reveal
        data-parallax="0.03"
      >
        <div class="w-full aspect-[4/3] overflow-hidden bg-lavender/20">
          <svg class="w-full h-full" viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="240" height="180" fill="#EDE8F5"/>
            <ellipse cx="120" cy="90" rx="80" ry="60" fill="#9B87C0" opacity="0.14"/>
            <ellipse cx="80" cy="70" rx="40" ry="35" fill="#4A3060" opacity="0.08"/>
            <ellipse cx="170" cy="110" rx="35" ry="28" fill="#C9A96E" opacity="0.09"/>
            <circle cx="120" cy="90" r="30" fill="none" stroke="#C9A96E" stroke-width="0.6" opacity="0.2"/>
            <text x="120" y="148" text-anchor="middle" font-size="9" fill="#9B87C0" opacity="0.45" font-family="serif">PHOTO 3 — LARGE</text>
          </svg>
          <!--
            PLACEHOLDER: Replace with actual photo 3 (hero photo)
            <img src="/images/gallery-3.webp" alt="Photo of couple" width="240" height="180"
                 class="w-full h-full object-cover" loading="lazy" decoding="async"/>
          -->
        </div>
        <div class="absolute inset-3 pointer-events-none border border-gold/12 rounded-sm" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Row 3: One smaller offset photo -->
    <div class="flex justify-end" style="padding-right: 8%;">
      <div
        class="relative ornament-border bg-ivory p-2 rounded-sm"
        style="width: 48%; transform: rotate(5deg); transform-origin: center top; animation-delay: 0.55s;"
        data-reveal
        data-parallax="0.1"
      >
        <div class="w-full aspect-[3/4] overflow-hidden bg-lavender/20">
          <svg class="w-full h-full" viewBox="0 0 150 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="150" height="200" fill="#FAF7F0"/>
            <ellipse cx="75" cy="100" rx="42" ry="58" fill="#C8B8E8" opacity="0.22"/>
            <ellipse cx="55" cy="85" rx="20" ry="32" fill="#9B87C0" opacity="0.12"/>
            <circle cx="100" cy="120" r="22" fill="#C9A96E" opacity="0.08"/>
            <text x="75" y="168" text-anchor="middle" font-size="8" fill="#9B87C0" opacity="0.45" font-family="serif">PHOTO 4</text>
          </svg>
          <!--
            PLACEHOLDER: Replace with actual photo 4
            <img src="/images/gallery-4.webp" alt="Photo of couple" width="150" height="200"
                 class="w-full h-full object-cover" loading="lazy" decoding="async"/>
          -->
        </div>
        <div class="absolute inset-2 pointer-events-none border border-gold/15 rounded-sm" aria-hidden="true"></div>
      </div>
    </div>

  </div>
</section>
