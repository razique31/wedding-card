---
/**
 * Hero.astro — Cinematic Invitation Cover
 *
 * FULL-SCREEN VIDEO VISUAL BACKGROUND
 * HTML TEXT ON TOP
 * SCROLL-CONTROLLED CINEMATIC ANIMATION
 */
---

<div
  id="hero-scroll-container"
  class="relative w-full overflow-x-hidden"
  style="height: 600vh;"
>
  <section
    id="hero"
    class="relative w-full h-[100svh] min-h-[100vh] overflow-hidden bg-[#1A1128]"
    aria-label="Wedding invitation cover"
  >
    <!-- 1. VIDEO LAYER (z-0) -->
    <div class="absolute inset-0 w-full h-full z-0 transform-gpu">
      <video
        id="hero-video"
        src="/video/invitation.mp4"
        poster="/video/poster.svg"
        class="w-full h-full object-cover object-center block"
        muted
        playsinline
        webkit-playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"></video>
    </div>

    <!-- 2. DECORATIVE OVERLAYS (z-10) -->
    <div
      class="absolute inset-0 z-10 bg-gradient-to-t from-[#1A1128]/70 via-[#1A1128]/20 to-[#1A1128]/40 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <!-- 3. TEXT / INVITATION CONTENT (z-20) -->
    <div
      class="absolute inset-0 z-20 flex flex-col items-center justify-between py-[12vh] px-6 pointer-events-none text-center"
    >
      <!-- Top Text: Bismillah -->
      <div
        id="hero-text-top"
        class="w-full flex flex-col items-center opacity-0 translate-y-4"
        style="will-change: transform, opacity;"
      >
        <p
          class="font-arabic font-yulltan leading-loose mb-1 text-[#F5F0E8] drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
          dir="rtl"
          lang="ar"
          style="font-size: clamp(1.5rem, 5vw, 2rem);"
        >
          بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ
        </p>
        <p
          class="text-[#F5F0E8]/90 text-[0.65rem] uppercase tracking-[0.3em] font-body mt-2 drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
        >
          The Wedding Of
        </p>
      </div>

      <!-- Center: Empty space for video's wax seal -->
      <div class="flex-1"></div>

      <!-- Bottom Text: Names, Date -->
      <div
        id="hero-text-bottom"
        class="w-full flex flex-col items-center opacity-0 translate-y-4 pb-30"
        style="will-change: transform, opacity;"
      >
        <div
          class="flex flex-col items-center justify-center mb-6 drop-shadow-[0_4px_8px_rgba(0,0,0,0.6)]"
        >
          <h1
            class="font-display leading-none text-[#C9A96E]"
            style="font-size: clamp(2.5rem, 8vw, 4.5rem);"
          >
            Farheen Naaz
          </h1>
          <div class="my-2 flex items-center justify-center gap-4">
            <span
              class="block h-px bg-[#C9A96E]/60"
              style="width: clamp(2rem, 6vw, 4rem);"></span>
            <span
              class="font-display italic text-[#C9A96E]"
              style="font-size: clamp(1.5rem, 5vw, 2.5rem);">&amp;</span
            >
            <span
              class="block h-px bg-[#C9A96E]/60"
              style="width: clamp(2rem, 6vw, 4rem);"></span>
          </div>
          <h1
            class="font-display leading-none text-[#C9A96E]"
            style="font-size: clamp(2.5rem, 8vw, 4.5rem);"
          >
            Sk Abdul Wasim
          </h1>
        </div>
        <p
          class="font-body uppercase tracking-[0.4em] font-semibold text-[#F5F0E8] drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] mb-8"
          style="font-size: clamp(0.7rem, 2.5vw, 0.9rem);"
        >
          27 December 2026
        </p>
      </div>
    </div>

    <!-- 4. TAP TO OPEN BUTTON (z-30) -->
    <!-- Positioned precisely over the video's central wax seal -->
    <div
      id="tap-overlay"
      class="absolute inset-0 z-30 flex flex-col items-center justify-center transition-all duration-700 pointer-events-none"
    >
      <div
        id="tap-btn"
        class="group relative w-40 h-40 rounded-full cursor-pointer outline-none bg-transparent pointer-events-auto flex items-center justify-center"
        role="button"
        tabindex="0"
        aria-label="Open wedding invitation"
      >
        <!-- Subtle pulsing rings that surround the physical seal in the video -->
        <!--<span class="absolute inset-0 rounded-full border border-[#C9A96E]/100 animate-ping" style="animation-duration: 3s;"></span>
        <span class="absolute inset-[-10px] rounded-full border border-[#C9A96E]/80 animate-ping" style="animation-duration: 4s; animation-delay: 1.5s;"></span>-->

        <!-- Magical pulsing stars around the ring -->

        <!-- Magical leaking stars around the seal -->
        <div class="magic-ring absolute inset-[-65px] pointer-events-none">
          <!-- Ring -->

          <!-- Stars -->
          <span class="magic-star star-1">✦</span>
          <span class="magic-star star-2">✧</span>
          <span class="magic-star star-3">✦</span>
          <span class="magic-star star-4">✧</span>
          <span class="magic-star star-5">✧</span>
          <span class="magic-star star-6">✦</span>
          <span class="magic-star star-7">✧</span>
          <span class="magic-star star-8">✦</span>
          <span class="magic-star star-9">✧</span>
          <span class="magic-star star-10">✦</span>
          <span class="magic-star star-11">✧</span>
        </div>

        <style>
          .magic-ring {
            position: absolute;
            pointer-events: none;
            contain: layout paint style;
          }

          .magic-ring-border {
            position: absolute;
            inset: 10px;
            border: 1px solid rgba(201, 169, 110, 0.7);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(201, 169, 110, 0.25);
          }

          .magic-star {
            position: absolute;
            /* color: #ecdec2ff; */
            color: rgb(255, 255, 255);
            line-height: 1;
            opacity: 0;
            will-change: transform, opacity;
            backface-visibility: hidden;

            text-shadow:
              0 0 4px rgba(201, 169, 110, 1),
              0 0 10px rgba(201, 169, 110, 0.8),
              0 0 20px rgba(201, 169, 110, 0.45);

            animation: magicalLeak 2.5s ease-out infinite;
          }

          /*
   * Stars originate close to the ring
   * and leak outward.
   */

          .star-1 {
            top: 15%;
            left: 50%;
            font-size: 24px;
            animation-delay: 0s;
            --x: 0px;
            --y: -45px;
            filter: blur(2px);
          }

          .star-2 {
            top: 22%;
            left: 66%;
            font-size: 19px;
            animation-delay: 0.7s;
            --x: 30px;
            --y: -35px;
            filter: blur(2px);
          }

          .star-3 {
            top: 36%;
            left: 83%;
            font-size: 23px;
            animation-delay: 1.4s;
            --x: 45px;
            --y: -10px;
            filter: blur(2px);
          }

          .star-4 {
            top: 50%;
            left: 90%;
            font-size: 18px;
            animation-delay: 2.1s;
            --x: 48px;
            --y: 0px;
            filter: blur(2px);
          }

          .star-5 {
            top: 67%;
            left: 82%;
            font-size: 21px;
            animation-delay: 0.4s;
            --x: 40px;
            --y: 25px;
            filter: blur(2px);
          }

          .star-6 {
            top: 83%;
            left: 62%;
            font-size: 25px;
            animation-delay: 1.7s;
            --x: 20px;
            --y: 42px;
            filter: blur(2px);
          }

          .star-7 {
            top: 82%;
            left: 43%;
            font-size: 19px;
            animation-delay: 2.4s;
            --x: 0px;
            --y: 48px;
            filter: blur(2px);
          }

          .star-8 {
            top: 76%;
            left: 20%;
            font-size: 23px;
            animation-delay: 1s;
            --x: -35px;
            --y: 35px;
            filter: blur(2px);
          }

          .star-9 {
            top: 55%;
            left: 8%;
            font-size: 18px;
            animation-delay: 2.8s;
            --x: -48px;
            --y: 5px;
            filter: blur(2px);
          }

          .star-10 {
            top: 34%;
            left: 17%;
            font-size: 21px;
            animation-delay: 0.3s;
            --x: -38px;
            --y: -25px;
            filter: blur(2px);
          }

          .star-11 {
            top: 19%;
            left: 36%;
            font-size: 18px;
            animation-delay: 1.2s;
            --x: -15px;
            --y: -40px;
            filter: blur(2px);
          }

          @keyframes magicalLeak {
            /* Born underneath the ring */
            0% {
              opacity: 0;
              transform: translate(0, 0) scale(0.15);
            }

            /* Suddenly appears */
            12% {
              opacity: 0.9;
              transform: translate(calc(var(--x) * 0.15), calc(var(--y) * 0.15))
                scale(0.75);
            }

            /* Leaks outward */
            45% {
              opacity: 1;
              transform: translate(calc(var(--x) * 0.55), calc(var(--y) * 0.55))
                scale(1);
            }

            /* Ease-out: slows near the end */
            78% {
              opacity: 0.55;
              transform: translate(calc(var(--x) * 0.85), calc(var(--y) * 0.85))
                scale(0.7);
            }

            /* Disappears */
            100% {
              opacity: 0;
              transform: translate(var(--x), var(--y)) scale(0.25);
            }
          }

          @media (prefers-reduced-motion: reduce) {
            .magic-star {
              animation: none;
              opacity: 0.7;
            }
          }
        </style>
      </div>

      <!-- Instructional text right below the seal -->
      <p
        class="absolute mt-[40rem] text-[#C9A96E] text-[0.75rem] uppercase tracking-[0.5em] font-body font-medium drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] pointer-events-none"
      >
        Tap Seal to Open
      </p>
    </div>
  </section>
</div>

<script>
  import { initHeroCinematic } from "../../scripts/hero-cinematic";
  initHeroCinematic();
</script>
