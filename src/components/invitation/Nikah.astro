---
/**
 * Nikah.astro — The Nikah ceremony section
 *
 * Art direction: deep plum-to-lavender gradient background, ornate Mughal arch
 * in gold SVG with cusp details, jaali pattern, Arabic calligraphy, and
 * floating gold petals. Most sacred section of the invitation.
 */
---

<section
  id="nikah"
  class="relative section-padding text-center overflow-hidden"
  aria-label="Nikah ceremony details"
  style="background: linear-gradient(180deg, #4A3060 0%, #6B4E8A 55%, #9B87C0 100%);"
>

  <!-- ── Jaali SVG pattern overlay (gold, very subtle) ── -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" data-parallax="0.05">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="nikah-jaali" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <polygon points="10,0 30,0 40,10 40,30 30,40 10,40 0,30 0,10" fill="none" stroke="#C9A96E" stroke-width="0.35"/>
          <circle cx="20" cy="20" r="3" fill="none" stroke="#C9A96E" stroke-width="0.3"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#nikah-jaali)" opacity="0.08"/>
    </svg>
  </div>

  <!-- ── Floating gold petals ── -->
  <!-- Petal 1 -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="top: 12%; left: 5%; opacity: 0.22; animation-delay: 0s;">
    <svg width="28" height="18" viewBox="0 0 28 18" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14 1 C20 1 27 7 27 9 C27 11 20 17 14 17 C8 17 1 11 1 9 C1 7 8 1 14 1 Z" fill="#C9A96E" opacity="0.6"/>
    </svg>
  </div>
  <!-- Petal 2 -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="top: 25%; right: 8%; opacity: 0.18; animation-delay: 3s;">
    <svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M11 1 C16 1 21 5 21 7 C21 9 16 13 11 13 C6 13 1 9 1 7 C1 5 6 1 11 1 Z" fill="#D4B98A" opacity="0.55"/>
    </svg>
  </div>
  <!-- Petal 3 -->
  <div class="petal absolute pointer-events-none" aria-hidden="true" style="bottom: 18%; left: 10%; opacity: 0.2; animation-delay: 6s;">
    <svg width="24" height="16" viewBox="0 0 24 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 1 C18 1 23 6 23 8 C23 10 18 15 12 15 C6 15 1 10 1 8 C1 6 6 1 12 1 Z" fill="#C9A96E" opacity="0.5"/>
    </svg>
  </div>

  <!-- ── Ornate Mughal arch SVG ── -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none"
    aria-hidden="true"
    data-parallax="0.06"
  >
    <svg
      viewBox="0 0 380 580"
      class="w-full h-auto max-h-[90dvh]"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      data-draw
    >
      <!-- Outer arch -->
      <path
        d="M35 560 L35 230 Q35 130 100 80 Q150 42 190 20 Q230 42 280 80 Q345 130 345 230 L345 560"
        stroke="#C9A96E"
        stroke-width="1.4"
        fill="none"
        opacity="0.3"
      />
      <!-- Inner arch -->
      <path
        d="M55 560 L55 238 Q55 145 115 98 Q162 64 190 46 Q218 64 265 98 Q325 145 325 238 L325 560"
        stroke="#C9A96E"
        stroke-width="0.7"
        fill="none"
        opacity="0.2"
      />
      <!-- Multi-cusp horseshoe detail — signature of ornate Mughal arch -->
      <!-- Primary cusps -->
      <path d="M190 20 Q205 30 214 50 Q220 64 214 78 Q204 65 190 60 Q176 65 166 78 Q160 64 166 50 Q175 30 190 20 Z"
        stroke="#C9A96E" stroke-width="0.8" fill="none" opacity="0.25"/>
      <!-- Secondary cusp flanks -->
      <path d="M140 52 Q130 45 125 38 Q130 32 140 38 Q148 44 145 55 Z" stroke="#C9A96E" stroke-width="0.5" fill="none" opacity="0.2"/>
      <path d="M240 52 Q250 45 255 38 Q250 32 240 38 Q232 44 235 55 Z" stroke="#C9A96E" stroke-width="0.5" fill="none" opacity="0.2"/>
      <!-- Keystone finial -->
      <path d="M190 14 L186 5 L190 0 L194 5 Z" fill="#C9A96E" opacity="0.35"/>
      <circle cx="190" cy="0" r="3" fill="none" stroke="#C9A96E" stroke-width="0.6" opacity="0.3"/>
      <!-- Spandrel bracket lines -->
      <line x1="35" y1="230" x2="55" y2="238" stroke="#C9A96E" stroke-width="0.5" opacity="0.15"/>
      <line x1="345" y1="230" x2="325" y2="238" stroke="#C9A96E" stroke-width="0.5" opacity="0.15"/>
      <!-- Base line -->
      <line x1="35" y1="558" x2="345" y2="558" stroke="#C9A96E" stroke-width="0.8" opacity="0.2"/>
    </svg>
  </div>

  <!-- ── Content ── -->
  <div class="relative z-10 w-full">

    <!-- Arabic: نكاح (Nikah) -->
    <div class="mb-4" data-reveal>
      <p
        class="font-arabic text-gold leading-loose"
        dir="rtl"
        lang="ar"
        style="font-size: clamp(2.5rem, 10vw, 4rem); color: #C9A96E;"
        aria-label="Nikah — Arabic calligraphy"
      >
        نِكَاح
      </p>
    </div>

    <!-- English heading -->
    <h2
      class="font-display text-champagne mb-2"
      style="font-size: clamp(1.6rem, 5vw, 2.4rem); color: #F0E6CC;"
      data-reveal
    >
      The Nikah Ceremony
    </h2>

    <!-- Sub label -->
    <p class="text-[0.6rem] uppercase tracking-[0.4em] mb-6 font-body" style="color: #C8B8E8;" data-reveal>
      A Sacred Union in the Presence of Allah
    </p>

    <!-- Gold ornamental divider -->
    <div class="mb-10 flex items-center justify-center gap-3" aria-hidden="true" data-reveal>
      <span class="block h-px" style="width: clamp(2rem, 8vw, 4rem); background: rgba(201,169,110,0.5);"></span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 1 L11.4 8.6 L19 10 L11.4 11.4 L10 19 L8.6 11.4 L1 10 L8.6 8.6 Z" fill="#C9A96E" opacity="0.8"/>
      </svg>
      <span class="block h-px" style="width: clamp(2rem, 8vw, 4rem); background: rgba(201,169,110,0.5);"></span>
    </div>

    <!-- Event details -->
    <div class="ornament-border bg-white/5 backdrop-blur-[2px] p-8 rounded-sm mb-8" data-reveal>
      <!-- Date -->
      <div class="mb-5">
        <p class="text-[0.58rem] uppercase tracking-[0.35em] font-body mb-1" style="color: #C8B8E8;">Date</p>
        <p class="font-display text-gold" style="font-size: clamp(1rem, 3.5vw, 1.3rem); color: #C9A96E;">
          27 December 2026
        </p>
      </div>

      <!-- Thin divider -->
      <div class="block h-px mx-8 mb-5" style="background: rgba(201,169,110,0.2);" aria-hidden="true"></div>

      <!-- Time -->
      <div class="mb-5">
        <p class="text-[0.58rem] uppercase tracking-[0.35em] font-body mb-1" style="color: #C8B8E8;">Time</p>
        <p class="font-display" style="font-size: clamp(1rem, 3.5vw, 1.3rem); color: #F0E6CC;">
          <!-- PLACEHOLDER: TIME -->
          TIME_PLACEHOLDER
        </p>
      </div>

      <div class="block h-px mx-8 mb-5" style="background: rgba(201,169,110,0.2);" aria-hidden="true"></div>

      <!-- Venue name -->
      <div class="mb-4">
        <p class="text-[0.58rem] uppercase tracking-[0.35em] font-body mb-1" style="color: #C8B8E8;">Venue</p>
        <p class="font-display" style="font-size: clamp(1rem, 3.5vw, 1.3rem); color: #F0E6CC;">
          <!-- PLACEHOLDER: NIKAH VENUE NAME -->
          NIKAH_VENUE_NAME
        </p>
      </div>

      <!-- Address -->
      <p class="font-body leading-relaxed" style="font-size: clamp(0.75rem, 2.5vw, 0.85rem); color: #C8B8E8;">
        <!-- PLACEHOLDER: VENUE ADDRESS -->
        VENUE_ADDRESS_LINE_1<br/>
        VENUE_ADDRESS_LINE_2
      </p>
    </div>

    <!-- Action buttons -->
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-center" data-reveal>
      <!-- Add to Calendar -->
      <a
        href="#"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 border font-body text-[0.65rem] uppercase tracking-[0.25em] transition-colors duration-300"
        style="border-color: rgba(201,169,110,0.5); color: #C9A96E;"
        aria-label="Add Nikah ceremony to your calendar"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="1" y="2" width="12" height="11" rx="1" stroke="currentColor" stroke-width="1"/>
          <line x1="4" y1="1" x2="4" y2="4" stroke="currentColor" stroke-width="1"/>
          <line x1="10" y1="1" x2="10" y2="4" stroke="currentColor" stroke-width="1"/>
          <line x1="1" y1="6" x2="13" y2="6" stroke="currentColor" stroke-width="1"/>
        </svg>
        Add to Calendar
      </a>
      <!-- Get Directions -->
      <a
        href="https://maps.google.com/?q=NIKAH_VENUE_ADDRESS"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 border font-body text-[0.65rem] uppercase tracking-[0.25em] transition-colors duration-300"
        style="border-color: rgba(201,169,110,0.5); color: #C9A96E;"
        aria-label="Get directions to the Nikah venue"
      >
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
          <path d="M6 1 C3.24 1 1 3.24 1 6 C1 9.75 6 13 6 13 C6 13 11 9.75 11 6 C11 3.24 8.76 1 6 1 Z" stroke="currentColor" stroke-width="1" fill="none"/>
          <circle cx="6" cy="6" r="1.5" fill="currentColor"/>
        </svg>
        Get Directions
      </a>
    </div>

  </div>
</section>
