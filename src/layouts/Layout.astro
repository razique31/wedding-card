---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Farheen Naaz & Sk Abdul Wasim — Wedding Invitation | 27 December 2026",
  description = "You are cordially invited to celebrate the wedding of Farheen Naaz and Sk Abdul Wasim on 27 December 2026.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://example.com",
);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="video/poster.svg"
      as="image"
      type="image/svg+xml"
      fetchpriority="high"
    />

    <!-- Force browser to disable scroll restoration and snap to top immediately on reload -->
    <script is:inline>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
      document.documentElement.scrollTop = 0;
      if (document.body) document.body.scrollTop = 0;

      window.addEventListener("beforeunload", function () {
        window.scrollTo(0, 0);
      });
      window.addEventListener("pagehide", function () {
        window.scrollTo(0, 0);
      });
      window.addEventListener("pageshow", function () {
        window.scrollTo(0, 0);
      });
    </script>

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme (plum for status bar) -->
    <meta name="theme-color" content="#2A1F3D" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { scope: "/" });
        });
      }
    </script>

    <!-- Google Fonts — preconnect then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 
    Critical fonts only: Playfair Display (display headings) + Plus Jakarta Sans (body)
    Noto Naskh Arabic loaded below with display=swap to avoid blocking
  -->
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Arabic font: loaded non-blocking -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Local Arabic / Islamic Display Font -->
    <link
      rel="preload"
      href="/Yulltan-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <!-- Preload Invitation Video for Instant Smooth Playback -->
    <link
      rel="preload"
      href="/video/invitation.webm"
      as="video"
      type="video/webm"
    />

    <!-- Global Styles -->
    <style>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <!-- 
    Card Composition:
    Mobile: full-bleed 9:16 vertical experience
    Desktop: centered vertical card on rich plum/velvet background
  -->
    <div class="card-composition" id="card-root">
      <slot />
    </div>

    <!-- Background Audio (Loops infinitely after user unlocks the invitation) -->
    <audio id="bg-music" src="/music/instrumental.mp3" loop preload="auto"
    ></audio>

    <!-- Floating Audio Control Toggle -->
    <button
      id="music-toggle"
      type="button"
      class="fixed bottom-5 right-5 z-50 w-11 h-11 rounded-full flex items-center justify-center bg-[#1A1128]/85 backdrop-blur-md border border-[#C9A96E]/50 text-[#C9A96E] shadow-[0_4px_16px_rgba(0,0,0,0.6)] cursor-pointer transition-all duration-500 opacity-0 pointer-events-none translate-y-3 hover:scale-105 active:scale-95"
      aria-label="Toggle background music"
      title="Toggle music"
    >
      <!-- Sound waves playing icon -->
      <span
        id="music-icon-playing"
        class="flex items-end justify-center gap-[2.5px] w-5 h-4"
      >
        <span class="music-bar bar-1 w-[2.5px] bg-[#C9A96E] rounded-full h-full"
        ></span>
        <span class="music-bar bar-2 w-[2.5px] bg-[#C9A96E] rounded-full h-3/4"
        ></span>
        <span class="music-bar bar-3 w-[2.5px] bg-[#C9A96E] rounded-full h-full"
        ></span>
        <span class="music-bar bar-4 w-[2.5px] bg-[#C9A96E] rounded-full h-1/2"
        ></span>
      </span>
      <!-- Sound muted icon -->
      <span id="music-icon-muted" class="hidden text-sm">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path
            d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
          ></path>
        </svg>
      </span>
    </button>

    <style>
      .music-bar {
        animation: musicWave 1.2s ease-in-out infinite alternate;
        transform-origin: bottom;
      }
      .music-bar.bar-1 {
        animation-delay: 0.1s;
      }
      .music-bar.bar-2 {
        animation-delay: 0.4s;
      }
      .music-bar.bar-3 {
        animation-delay: 0.2s;
      }
      .music-bar.bar-4 {
        animation-delay: 0.5s;
      }

      @keyframes musicWave {
        0% {
          transform: scaleY(0.3);
        }
        100% {
          transform: scaleY(1);
        }
      }
    </style>
  </body>
</html>
